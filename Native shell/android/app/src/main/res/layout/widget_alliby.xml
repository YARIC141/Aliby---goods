<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_background"
    android:padding="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="8dp"
        android:paddingRight="4dp"
        android:paddingBottom="2dp">

        <TextView
            android:id="@+id/widget_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Alliby"
            android:textColor="#1a1a1a"
            android:textSize="16sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/widget_btn_theme"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="Сменить тему"
            android:padding="7dp"
            android:src="@drawable/ic_widget_theme" />

        <ImageButton
            android:id="@+id/widget_btn_settings"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="Напоминания"
            android:padding="7dp"
            android:src="@drawable/ic_widget_settings" />

        <ImageButton
            android:id="@+id/widget_btn_open"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="Открыть приложение"
            android:padding="6dp"
            android:src="@drawable/ic_widget_open" />

        <ImageButton
            android:id="@+id/widget_btn_orders_toggle"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="Показывать заказы"
            android:padding="7dp"
            android:src="@drawable/ic_widget_checkbox_checked" />

        <LinearLayout
            android:id="@+id/widget_mode_switch"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginLeft="4dp"
            android:orientation="horizontal"
            android:padding="2dp">

            <FrameLayout
                android:id="@+id/widget_mode_note_wrap"
                android:layout_width="32dp"
                android:layout_height="32dp">

                <ImageButton
                    android:id="@+id/widget_btn_mode_note"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@android:color/transparent"
                    android:contentDescription="Список"
                    android:padding="7dp"
                    android:src="@drawable/ic_widget_note" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/widget_mode_calendar_wrap"
                android:layout_width="32dp"
                android:layout_height="32dp">

                <ImageButton
                    android:id="@+id/widget_btn_mode_calendar"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@android:color/transparent"
                    android:contentDescription="Календарь"
                    android:padding="7dp"
                    android:src="@drawable/ic_widget_calendar" />
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="4dp"
        android:paddingRight="4dp"
        android:paddingBottom="4dp">

        <ImageButton
            android:id="@+id/widget_btn_prev_day"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="Предыдущий день"
            android:padding="7dp"
            android:src="@drawable/ic_widget_prev" />

        <TextView
            android:id="@+id/widget_date_label"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:textColor="#666666"
            android:textSize="13sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/widget_btn_next_day"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="Следующий день"
            android:padding="7dp"
            android:src="@drawable/ic_widget_next" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ListView
            android:id="@+id/widget_list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:divider="#eeeeee"
            android:dividerHeight="1px"
            android:listSelector="@android:color/transparent" />

        <TextView
            android:id="@+id/widget_empty"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="Нет событий в этот день"
            android:textColor="#999999"
            android:textSize="13sp" />

        <LinearLayout
            android:id="@+id/widget_calendar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="Пн"
                    android:textColor="#999999"
                    android:textSize="11sp" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="Вт"
                    android:textColor="#999999"
                    android:textSize="11sp" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="Ср"
                    android:textColor="#999999"
                    android:textSize="11sp" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="Чт"
                    android:textColor="#999999"
                    android:textSize="11sp" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="Пт"
                    android:textColor="#999999"
                    android:textSize="11sp" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="Сб"
                    android:textColor="#999999"
                    android:textSize="11sp" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="Вс"
                    android:textColor="#999999"
                    android:textSize="11sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/widget_calendar_weeks"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/widget_btn_add"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_gravity="bottom|right"
            android:layout_margin="8dp"
            android:background="@drawable/widget_fab_bg"
            android:contentDescription="Добавить событие"
            android:padding="10dp"
            android:src="@drawable/ic_widget_add_white" />
    </FrameLayout>
</LinearLayout>
