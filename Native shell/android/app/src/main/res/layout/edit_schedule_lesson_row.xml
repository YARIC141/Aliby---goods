<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/lesson_row_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:background="@drawable/dialog_field_bg"
    android:orientation="vertical"
    android:padding="10dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <EditText
            android:id="@+id/lesson_input_subject"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:hint="Предмет"
            android:inputType="text"
            android:maxLines="1"
            android:textSize="15sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/lesson_btn_delete"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="Удалить урок"
            android:padding="4dp"
            android:src="@drawable/ic_dialog_close" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <EditText
            android:id="@+id/lesson_input_room"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:hint="Кабинет"
            android:inputType="text"
            android:maxLines="1"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/lesson_btn_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:clickable="true"
            android:focusable="true"
            android:hint="Время"
            android:padding="4dp"
            android:textSize="13sp" />

        <EditText
            android:id="@+id/lesson_input_duration"
            android:layout_width="48dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:background="@android:color/transparent"
            android:gravity="end"
            android:hint="мин"
            android:inputType="number"
            android:maxLines="1"
            android:textSize="13sp" />
    </LinearLayout>

    <EditText
        android:id="@+id/lesson_input_homework"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:background="@android:color/transparent"
        android:hint="Домашнее задание"
        android:inputType="textMultiLine"
        android:maxLines="3"
        android:textSize="13sp" />
</LinearLayout>
