<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/pet_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_background"
    android:padding="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="8dp"
        android:paddingRight="4dp"
        android:paddingBottom="2dp">

        <TextView
            android:id="@+id/pet_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="🐾 Питомец"
            android:textColor="#1a1a1a"
            android:textSize="16sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/pet_btn_theme"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="Сменить тему"
            android:padding="7dp"
            android:src="@drawable/ic_widget_theme" />

        <ImageButton
            android:id="@+id/pet_btn_open"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="Открыть приложение"
            android:padding="6dp"
            android:src="@drawable/ic_widget_open" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:id="@+id/pet_metrics"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:padding="6dp">

                    <TextView
                        android:id="@+id/pet_lbl_steps"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="👣 Шаги"
                        android:textColor="#999999"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/pet_val_steps"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="—"
                        android:textColor="#1a1a1a"
                        android:textSize="16sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:padding="6dp">

                    <TextView
                        android:id="@+id/pet_lbl_distance"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="📏 Дистанция"
                        android:textColor="#999999"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/pet_val_distance"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="—"
                        android:textColor="#1a1a1a"
                        android:textSize="16sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:padding="6dp">

                    <TextView
                        android:id="@+id/pet_lbl_calories"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🔥 Калории"
                        android:textColor="#999999"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/pet_val_calories"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="—"
                        android:textColor="#1a1a1a"
                        android:textSize="16sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:padding="6dp">

                    <TextView
                        android:id="@+id/pet_lbl_sleep"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="😴 Сон"
                        android:textColor="#999999"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/pet_val_sleep"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="—"
                        android:textColor="#1a1a1a"
                        android:textSize="16sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:padding="6dp">

                    <TextView
                        android:id="@+id/pet_lbl_exercise"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="💪 Тренировка"
                        android:textColor="#999999"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/pet_val_exercise"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="—"
                        android:textColor="#1a1a1a"
                        android:textSize="16sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:padding="6dp">

                    <TextView
                        android:id="@+id/pet_lbl_heart"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="❤️ Пульс"
                        android:textColor="#999999"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/pet_val_heart"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="—"
                        android:textColor="#1a1a1a"
                        android:textSize="16sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:padding="6dp">

                    <TextView
                        android:id="@+id/pet_lbl_muscle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="💪 Мышцы за день"
                        android:textColor="#999999"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/pet_val_muscle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="—"
                        android:textColor="#1a1a1a"
                        android:textSize="16sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:padding="6dp">

                    <TextView
                        android:id="@+id/pet_lbl_fat"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🔥 Жир за день"
                        android:textColor="#999999"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/pet_val_fat"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="—"
                        android:textColor="#1a1a1a"
                        android:textSize="16sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/pet_empty"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:paddingLeft="16dp"
            android:paddingRight="16dp"
            android:text="Health Connect не подключён — откройте питомца в приложении"
            android:textColor="#999999"
            android:textSize="13sp"
            android:visibility="gone" />
    </FrameLayout>
</LinearLayout>
